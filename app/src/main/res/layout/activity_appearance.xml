<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar" android:layout_width="match_parent"
        android:layout_height="wrap_content" app:title="@string/profile_appearance"
        app:navigationContentDescription="@string/navigate_back" app:navigationIcon="@drawable/ic_arrow_back" />

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="@dimen/screen_margin">

            <LinearLayout android:id="@+id/appearanceThemeRow" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="80dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
                <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/appearance_mode_title" android:textAppearance="@style/TextAppearance.MyChat.Heading" />
                    <TextView android:id="@+id/appearanceThemeValue" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xs"
                        android:textAppearance="@style/TextAppearance.MyChat.Caption" />
                </LinearLayout>
                <ImageView android:layout_width="20dp" android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right" android:importantForAccessibility="no" />
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/screen_margin" android:text="@string/appearance_color_title"
                android:textAppearance="@style/TextAppearance.MyChat.Heading" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s" android:text="@string/appearance_color_description"
                android:textAppearance="@style/TextAppearance.MyChat.Body" />

            <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l" android:columnCount="2">
                <com.google.android.material.button.MaterialButton android:id="@+id/accentBlue"
                    style="@style/Widget.MyChat.Button.AccentChoice" />
                <com.google.android.material.button.MaterialButton android:id="@+id/accentGreen"
                    style="@style/Widget.MyChat.Button.AccentChoice" />
                <com.google.android.material.button.MaterialButton android:id="@+id/accentViolet"
                    style="@style/Widget.MyChat.Button.AccentChoice" />
                <com.google.android.material.button.MaterialButton android:id="@+id/accentRose"
                    style="@style/Widget.MyChat.Button.AccentChoice" />
                <com.google.android.material.button.MaterialButton android:id="@+id/accentAmber"
                    style="@style/Widget.MyChat.Button.AccentChoice" />
                <com.google.android.material.button.MaterialButton android:id="@+id/accentTeal"
                    style="@style/Widget.MyChat.Button.AccentChoice" />
            </GridLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/screen_margin" app:cardCornerRadius="@dimen/radius_bubble"
                app:cardElevation="0dp" app:strokeWidth="0dp" app:cardBackgroundColor="@color/sf">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="@dimen/space_l">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/appearance_preview_title" android:textAppearance="@style/TextAppearance.MyChat.Caption" />
                    <TextView android:id="@+id/accentPreviewMessage" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_gravity="end"
                        android:layout_marginTop="@dimen/space_m" android:background="@drawable/bg_bubble_sent"
                        android:paddingHorizontal="@dimen/space_m" android:paddingVertical="@dimen/space_s"
                        android:text="@string/appearance_preview_message" android:textColor="?attr/colorOnPrimary"
                        android:textSize="@dimen/text_body" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton android:id="@+id/restoreAccentButton"
                style="@style/Widget.MyChat.Button.Text" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_m"
                android:text="@string/appearance_restore_color" />
            <LinearLayout android:id="@+id/defaultWallpaperRow" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="80dp" android:layout_marginTop="@dimen/space_l" android:orientation="horizontal" android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/wallpaper_default_title" android:textAppearance="@style/TextAppearance.MyChat.Heading" />
                    <TextView android:id="@+id/defaultWallpaperValue" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs" android:textAppearance="@style/TextAppearance.MyChat.Caption" />
                </LinearLayout>
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" android:importantForAccessibility="no" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
