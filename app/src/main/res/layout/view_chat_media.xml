<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/mediaImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/sf2"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.MyChat.Image" />

    <ImageView
        android:id="@+id/mediaPlay"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_media_badge"
        android:importantForAccessibility="no"
        android:padding="14dp"
        android:src="@drawable/ic_play"
        android:visibility="gone" />

    <TextView
        android:id="@+id/mediaDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="@dimen/space_s"
        android:background="@drawable/bg_media_badge"
        android:importantForAccessibility="no"
        android:paddingHorizontal="@dimen/space_s"
        android:paddingVertical="2dp"
        android:textColor="@color/media_badge_ink"
        android:textSize="@dimen/text_caption"
        android:visibility="gone" />
</merge>
