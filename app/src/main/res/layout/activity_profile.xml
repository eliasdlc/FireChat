<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" tools:context=".ui.profile.ProfileActivity">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="wrap_content" app:navigationContentDescription="@string/navigate_back" app:navigationIcon="@drawable/ic_arrow_back" app:title="@string/profile_title" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:padding="@dimen/screen_margin" android:paddingTop="@dimen/space_xxl" android:paddingBottom="@dimen/space_xxl">
                <com.example.firechat.ui.common.AvatarView android:id="@+id/profileAvatar" android:layout_width="120dp" android:layout_height="120dp" android:background="@drawable/bg_avatar" android:gravity="center" android:importantForAccessibility="no" android:textColor="@color/ink" android:textSize="48sp" tools:text="A" />
                <TextView android:id="@+id/profileDisplayName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_l" android:gravity="center" android:textAppearance="@style/TextAppearance.MyChat.Display" tools:text="Ana Prueba" />
                <TextView android:id="@+id/profileEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_s" android:gravity="center" android:textAppearance="@style/TextAppearance.MyChat.Caption" android:textIsSelectable="true" tools:text="perfil@firechat.test" />
                <TextView android:id="@+id/profileStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="@dimen/space_s" android:accessibilityLiveRegion="polite" android:textAppearance="@style/TextAppearance.MyChat.Body" android:visibility="gone" />
                <TextView android:id="@+id/profileError" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="@dimen/space_s" android:accessibilityLiveRegion="polite" android:textAppearance="@style/TextAppearance.MyChat.Body" android:textColor="@color/error" android:visibility="gone" />
                <com.google.android.material.button.MaterialButton android:id="@+id/retryProfileButton" style="@style/Widget.MyChat.Button.Text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/profile_retry" android:visibility="gone" />
            </LinearLayout>
            <LinearLayout android:id="@+id/editProfileRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="80dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="@dimen/screen_margin" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_edit_profile" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="@dimen/screen_margin" android:layout_marginEnd="@dimen/space_m">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/profile_edit" android:textAppearance="@style/TextAppearance.MyChat.Heading" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xs" android:text="@string/profile_edit_description" android:textAppearance="@style/TextAppearance.MyChat.Caption" />
                </LinearLayout>
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" android:importantForAccessibility="no" />
            </LinearLayout>
            <LinearLayout android:id="@+id/appearanceRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="80dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="@dimen/screen_margin" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_appearance" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="@dimen/screen_margin" android:layout_marginEnd="@dimen/space_m">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/profile_appearance" android:textAppearance="@style/TextAppearance.MyChat.Heading" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xs" android:text="@string/profile_appearance_description" android:textAppearance="@style/TextAppearance.MyChat.Caption" />
                </LinearLayout>
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" android:importantForAccessibility="no" />
            </LinearLayout>
            <LinearLayout android:id="@+id/logoutProfileRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="80dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="@dimen/screen_margin" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_logout" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="@dimen/screen_margin" android:layout_marginEnd="@dimen/space_m">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/action_logout" android:textAppearance="@style/TextAppearance.MyChat.Heading" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xs" android:text="@string/profile_logout_description" android:textAppearance="@style/TextAppearance.MyChat.Caption" />
                </LinearLayout>
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" android:importantForAccessibility="no" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
